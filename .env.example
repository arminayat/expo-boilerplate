# Required for app startup. Use your own Supabase project.
# Client-visible publishable key (or legacy anon key), never service_role/secret.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: leave blank to disable PostHog. The app uses its EU host.
EXPO_PUBLIC_POSTHOG_API_KEY=

# Optional: public iOS SDK key. Android purchases are not configured.
EXPO_PUBLIC_APPLE_PURCHASES_API_KEY=

# Required only when using the password-reset email form.
# Provide your own reset-completion page and allow it in Supabase redirect URLs.
EXPO_PUBLIC_WEB_PASSWORD_RESET_URL=
