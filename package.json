{
  "name": "expo-boilerplate",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "web": "expo start --web -c",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "check": "npm run typecheck && npm run lint && npm run test:integrations && expo install --check",
    "export:native": "expo export --platform ios --platform android",
    "ios:pods": "pod-install",
    "generate-types": "node scripts/generate-supabase-types.cjs",
    "test:integrations": "node scripts/check-revenuecat.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
