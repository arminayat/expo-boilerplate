    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "packageManager": "npm@10.9.8",
  "private": true,
  "description": "A native-first Expo starter with HeroUI Native, Supabase auth, encrypted storage, and optional analytics and billing.",
