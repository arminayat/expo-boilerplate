    "react-native-toast-message": "^2.5.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
